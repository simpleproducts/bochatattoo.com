# Public base URL for image assets served from R2.
# Use the R2 public bucket URL (https://pub-xxxxxxxx.r2.dev) or your custom domain.
NEXT_PUBLIC_IMAGES_BASE_URL=https://images.bochatattoo.com

# Cloudflare R2 credentials — used by scripts/upload-images.mjs, the migration
# script, and the /admin runtime (image upload + manifest writes).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Brevo (newsletter) — server-only. Generate at https://app.brevo.com/settings/keys/api
# BREVO_LIST_ID is the numeric ID of the list new subscribers go into (optional but recommended).
BREVO_API_KEY=
BREVO_LIST_ID=

# Cloudflare Turnstile (newsletter form anti-abuse) — both keys must be set together,
# or leave both empty to disable. Get them at https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is public (NEXT_PUBLIC_) and ships to the browser; secret key stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin (image management at /admin)
# ADMIN_PASSWORD          plaintext password to gate /admin
# ADMIN_SESSION_SECRET    HMAC key for the session cookie. Generate with:
#                           openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Marketing pixels — both optional. Leave blank to disable each one.
# NEXT_PUBLIC_GA_MEASUREMENT_ID    GA4 measurement id, e.g. "G-XXXXXXXXXX"
# NEXT_PUBLIC_META_PIXEL_ID        Facebook/Meta pixel id, e.g. "1234567890123456"
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Bookings — private R2 bucket for appointment records and transfer receipts.
# R2_PRIVATE_BUCKET must be a SECOND bucket in the same R2 account, created with
# public access NOT enabled and NO custom domain bound. R2_BUCKET above is served
# publicly at NEXT_PUBLIC_IMAGES_BASE_URL, so anything written there is
# world-readable by key. The app refuses to start the booking feature if this
# value is empty or equal to R2_BUCKET. Uses the same R2_ACCOUNT_ID /
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY credentials above.
R2_PRIVATE_BUCKET=

# BOOKING_TOKEN_SECRET    HMAC key for the private booking links. Must differ from
#                         ADMIN_SESSION_SECRET. Rotating it invalidates every link
#                         already sent out. Generate with:
#                           openssl rand -hex 32
BOOKING_TOKEN_SECRET=

# Booking email — reuses BREVO_API_KEY above via https://api.brevo.com/v3/smtp/email.
# ALL THREE OF THESE ARE OPTIONAL. Left blank, booking mail is sent from
# info@bochatattoo.com to info@bochatattoo.com, signed "Bocha Tattoo" — no new
# credential and no new address. Set one only to override that default.
#
# The one thing that is NOT optional lives in Brevo, not here: whatever address
# ends up as the sender must be verified at https://app.brevo.com/senders, or
# every send comes back 400. Adding a sender there is free and takes a minute —
# Brevo mails the address a confirmation link. This is separate from the
# newsletter, which only writes contacts into a list and never sends anything.
#
# BREVO_SENDER_EMAIL      From address.        Default: info@bochatattoo.com
# BREVO_SENDER_NAME       From display name.   Default: "Bocha Tattoo"
# BOOKING_NOTIFY_EMAIL    Where notifications land. Default: info@bochatattoo.com
#
# A send that fails never fails the booking: the calendar stays the source of
# truth and the admin sheet shows the failure with a Resend button.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BOOKING_NOTIFY_EMAIL=

# NEXT_PUBLIC_STUDIO_TIMEZONE  IANA zone used to render times server-side before the
#                              browser swaps in the viewer's own zone, and for every
#                              time printed in an email (email clients run no JS).
#                              Optional, defaults to America/Argentina/Buenos_Aires.
NEXT_PUBLIC_STUDIO_TIMEZONE=America/Argentina/Buenos_Aires

# NEXT_PUBLIC_SITE_URL         Absolute origin used to build private booking links.
#                              Optional, defaults to https://bochatattoo.com. Set it on
#                              preview deploys so links point at the preview.
NEXT_PUBLIC_SITE_URL=https://bochatattoo.com

# MercadoPago (Checkout Pro) — the second way a client can pay the deposit.
# BOTH ARE SERVER-ONLY and neither belongs in the settings document: the admin
# tab decides WHETHER MercadoPago is offered, this decides whether it can work.
# With MP_ACCESS_TOKEN empty the method is simply never offered, exactly like
# the bank transfer with no CBU.
#
# MP_ACCESS_TOKEN     Access token of the studio's MercadoPago application, from
#                     https://www.mercadopago.com.ar/developers/panel/app — the
#                     credentials section. APP_USR-... in production, TEST-... to
#                     rehearse the flow; the code reads whichever is set and uses
#                     the matching checkout URL.
# MP_WEBHOOK_SECRET   The "clave secreta" MercadoPago shows when you register the
#                     notification URL. OPTIONAL but strongly recommended: with it
#                     set, every notification's x-signature header is verified
#                     before anything is written. Left empty the webhook still
#                     runs and says so in the log on every delivery — a payment is
#                     only ever confirmed by re-reading it from MercadoPago's API,
#                     never from the notification body, so an unsigned forgery
#                     still needs a real approved payment to do anything.
#
# THE NOTIFICATION URL MUST BE REGISTERED IN THE MERCADOPAGO DASHBOARD, under
# the application's Webhooks section, for the "payment" topic:
#
#   https://bochatattoo.com/api/mp/webhook
#
# Each preference also carries that URL, so payments started from the booking
# page notify without it — but the dashboard registration is what covers a
# payment MercadoPago reports through any other route, and it is where the
# secret above comes from. Point it at the preview origin on preview deploys,
# the same way NEXT_PUBLIC_SITE_URL is set there.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
